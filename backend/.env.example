FLASK_ENV=development
FLASK_APP=run.py

# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Local Docker: mongodb://localhost:27017/finance_thesis
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/finance_thesis?retryWrites=true&w=majority

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_random_64_char_string

ALPHA_VANTAGE_KEY=

CORS_ORIGINS=http://localhost:5173
